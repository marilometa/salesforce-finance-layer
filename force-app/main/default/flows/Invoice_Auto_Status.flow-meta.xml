<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <assignments>
        <name>Set_Paid</name>
        <label>Set Paid</label>
        <locationX>440</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Paid</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Partially_Paid</name>
        <label>Set Partially Paid</label>
        <locationX>700</locationX>
        <locationY>150</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Partially Paid</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Collection_State</name>
        <label>Collection State</label>
        <locationX>176</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>Untouched</defaultConnectorLabel>
        <rules>
            <name>Fully_Collected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Total_Collected__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Invoice_Amount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Invoice_Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Void</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Paid</targetReference>
            </connector>
            <label>Fully Collected</label>
        </rules>
        <rules>
            <name>Partially_Collected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Total_Collected__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Void</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Partially_Paid</targetReference>
            </connector>
            <label>Partially Collected</label>
        </rules>
    </decisions>
    <description>Before-save on Invoice: derives Paid / Partially Paid from the collected roll-up. Runs whenever a child allocation changes, because roll-up summary recalculation re-fires the parent's before-save automation — the mechanism that makes auto-status free. Draft, Sent, and Void remain manual.</description>
    <environments>Default</environments>
    <interviewLabel>Invoice Auto Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Invoice Auto Status</label>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Collection_State</targetReference>
        </connector>
        <object>Invoice__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
